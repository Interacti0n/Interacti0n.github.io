---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL;
---
<Layout title={`${profile.name} — CV`} description="Experience, projects, technical interests, and contact information for Jakub Bartošovič.">
  <article class="shell resume">
    <div class="resume-controls"><a class="text-link" href={base}>← Back to portfolio</a><div class="actions"><a class="button primary" href={`${base}jakub-bartosovic-resume.pdf`} download>Download PDF ↓</a><button type="button" class="button secondary" id="print-resume">Print</button></div></div>
    <header class="resume-header"><p class="eyebrow">CV / ENTRY-LEVEL IT</p><h1>{profile.name}</h1><p class="resume-role">{profile.role}</p><p>{profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a></p><p><a href={profile.github}>github.com/Interacti0n</a> · <a href={profile.linkedin}>linkedin.com/in/jakub-bartosovic</a></p></header>
    <section><h2>Profile</h2><p>Seeking an entry-level IT opportunity, with previous junior Oracle DBA experience and a background in automotive operations. In personal projects, I guide AI-generated implementation through instructions and feedback, manually try the applications, and report visual issues while learning from the code.</p></section>
    <section><h2>Experience</h2><div class="resume-item"><h3>Logistics / operations · Automotive industry</h3><p class="resume-date">Current role</p><ul><li>Coordinate material transport from warehouse to production line, organize people, and prioritize delayed or urgent deliveries.</li><li>Respond to material shortages by checking parts availability and order history, checking operational software, and handling phone coordination.</li></ul></div><div class="resume-item"><h3>Junior database administrator</h3><p class="resume-date">2022</p><ul><li>Basic Oracle Database user and access administration.</li><li>Simple SQL diagnostics; work with logs, monitoring, and Linux.</li></ul></div></section>
    <section><h2>Projects</h2><div class="resume-item"><h3><a href={`${base}projects/numforge/`}>NumForge</a> · C17, CMake</h3><p>A mathematics project with a C17 core and tools for precise calculations, graphs, equations, and matrices.</p><a href="https://github.com/Interacti0n/NumForge">github.com/Interacti0n/NumForge</a></div><div class="resume-item"><h3><a href={`${base}projects/twinstar-progress/`}>TwinStar Progress</a> · React, TypeScript, SQLite</h3><p>A live guild rankings website with searchable raid progress, speedkills, and scheduled data updates.</p><a href="https://twinstar-progress.pages.dev/">twinstar-progress.pages.dev</a></div><div class="resume-item"><h3><a href={`${base}projects/arc/`}>ARC — Advanced Raid Check</a> · Lua, WoW API</h3><p>A World of Warcraft addon helping raid leaders check group readiness, equipment, and raid-session activity.</p><a href="https://github.com/Interacti0n/ARC-Advanced-Raid-Check">github.com/Interacti0n/ARC-Advanced-Raid-Check</a></div></section>
    <section><h2>Education</h2><h3>FIIT STU · 2018–2021</h3><p>Three years of studies at the Faculty of Informatics and Information Technologies, Slovak University of Technology.</p></section>
    <section><h2>Skills & interests</h2><p><strong>Technologies in my AI-assisted projects:</strong> C17, CMake, Lua, React, TypeScript, SQLite, Cloudflare Pages.<br /><strong>Professional experience:</strong> Oracle Database, basic SQL diagnostics, access administration, logs, monitoring, Linux.<br /><strong>Interests:</strong> C, C#, .NET, backend development, databases, DevOps.<br /><strong>Workplace strengths:</strong> communication, prioritization, practical problem solving, operational awareness.</p></section>
    <section><h2>Languages</h2><p>Slovak — native · English — B2</p></section>
  </article>
</Layout>
<script>document.getElementById('print-resume')?.addEventListener('click', () => window.print());</script>
