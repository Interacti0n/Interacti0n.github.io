---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, skills } from '../data/profile';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<Layout>
  <section id="overview" class="hero shell" aria-labelledby="overview-heading">
    <div class="hero-content">
    <p class="eyebrow"><span class="dot"></span> {profile.location.toUpperCase()} / OPEN TO ENTRY-LEVEL IT ROLES</p>
    <h1 id="overview-heading">Building my future in<br /><span>IT & software development.</span></h1>
    <p class="hero-description">I’m {profile.name}. I bring <strong>previous junior Oracle DBA experience</strong> and a background in automotive operations. In my free time, I develop personal software projects with AI assistance and test them manually as I learn.</p>
    <div class="actions">
      <a class="button primary" href="#projects">Explore my projects <span aria-hidden="true">↓</span></a>
      <a class="button secondary" href={`${base}jakub-bartosovic-resume.pdf`} download>Download CV <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-links" aria-label="Professional profiles and contact">
      <a href={profile.github}>GitHub ↗</a><a href={profile.linkedin}>LinkedIn ↗</a><a href={`mailto:${profile.email}`}>Email me ↗</a><a href={`${base}resume/`}>View CV →</a>
    </div>
    </div>
    <dl class="career-summary" aria-label="My background at a glance">
      <div><dt>Experience</dt><dd>Junior Oracle DBA <span>2022</span></dd></div>
      <div><dt>Personal projects</dt><dd>Tools, data & web <span>AI-assisted development · manual testing</span></dd></div>
      <div><dt>Direction</dt><dd>Backend & databases <span>Open to entry-level IT opportunities</span></dd></div>
    </dl>
  </section>

  <section id="projects" class="section shell" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="projects-heading">Selected projects.</h2></div>
      <p>A mathematics toolkit, a live rankings website, and a game addon.<br />Explore what they do and how I contribute.</p>
    </div>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
    <p id="approach" class="project-context">Most project implementation is AI-generated. I guide the work through instructions and feedback, manually try the applications, and report visual issues while learning how the code works.</p>
  </section>

  <section id="background" class="section shell background" aria-labelledby="background-heading">
    <div>
      <p class="eyebrow">02 / EXPERIENCE & EDUCATION</p><h2 id="background-heading">Experience<br />& education.</h2>
      <p class="background-intro">My background combines junior database administration with hands-on coordination in automotive operations.</p>
      <div class="languages"><h3>Languages</h3><ul class="tags" aria-label="Languages"><li>Slovak <span>(native)</span></li><li>English <span>(B2)</span></li></ul></div>
      <a class="text-link resume-link" href={`${base}resume/`}>View CV →</a>
    </div>
    <div class="timeline">
      <article><span class="timeline-dot"></span><p class="eyebrow">CURRENT WORK</p><h3>Logistics & operations</h3><p>Coordinating material deliveries from the warehouse to the production line in the automotive industry.</p><ul class="experience-list"><li>Organize people and prioritize urgent or delayed deliveries.</li><li>Respond to material shortages, check parts availability and order history, and handle phone coordination.</li><li>Check operational software and help get the required parts to the line as quickly as possible.</li></ul></article>
      <article><span class="timeline-dot"></span><p class="eyebrow">2022</p><h3>Junior database administration</h3><p>Worked with Oracle Database in a junior DBA role.</p><ul class="experience-list"><li>Basic user and access administration.</li><li>Simple SQL diagnostics and work with logs, monitoring, and Linux.</li></ul></article>
      <article><span class="timeline-dot"></span><p class="eyebrow">2018–2021 / STUDIES</p><h3>FIIT STU</h3><p>Studied for three years at the Faculty of Informatics and Information Technologies, Slovak University of Technology.</p></article>
    </div>
  </section>

  <section id="skills" class="section shell" aria-labelledby="skills-heading">
    <div class="section-heading">
      <div><p class="eyebrow">03 / SKILLS & PRACTICE</p><h2 id="skills-heading">Skills & learning.</h2></div>
      <p>Previous IT work, personal project practice,<br />and interests for my next step.</p>
    </div>
    <div class="skills-grid">
      {skills.map((group, index) => <article class="skill-card">
        <span class="skill-number">0{index + 1}</span><h3>{group.title}</h3><p>{group.detail}</p>
        <ul class="tags">{group.items.map(item => <li>{item}</li>)}</ul>
      </article>)}
    </div>
    <div class="strengths">
      <h3>How I work</h3><p>Habits I bring from logistics and operations into my next role.</p>
      <dl class="strengths-grid">
        <div><dt>Teamwork & communication</dt><dd>Coordinating people and sharing clear updates to keep material moving to production.</dd></div>
        <div><dt>Prioritization</dt><dd>Adjusting priorities when deliveries are delayed or the production line needs material urgently.</dd></div>
        <div><dt>Practical problem solving</dt><dd>Checking parts availability and order history to find a way forward when material is missing.</dd></div>
        <div><dt>Operational awareness</dt><dd>Monitoring software and material flow to understand what needs attention.</dd></div>
      </dl>
    </div>
  </section>

  <section id="contact" class="shell contact-section" aria-labelledby="contact-heading">
    <div><p class="eyebrow">04 / GET IN TOUCH</p><h2 id="contact-heading">Let’s talk about<br /><span>my next step in IT.</span></h2><p>Open to entry-level IT opportunities, with an interest in backend development and databases. Based in Bratislava, Slovakia.</p></div>
    <div class="contact-links">
      <a href={`mailto:${profile.email}`}><span><small>Email</small>{profile.email}</span><span aria-hidden="true">↗</span></a>
      <a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
      <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
      <a href={`${base}resume/`}>View CV <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
