---
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; }
const { title = `${profile.name} — IT & software development portfolio`, description = profile.description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const sameAs = [profile.github, profile.linkedin].filter(Boolean);
const isProject = Astro.url.pathname.includes('/projects/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1020" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(`${base}social.png`, Astro.site).href} />}
    <meta property="og:image:alt" content="Jakub Bartošovič — entry-level IT candidate with previous junior Oracle DBA experience." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: profile.name, description, sameAs })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="navigation-bar">
    <header class="header shell">
      <a class="brand" href={base} aria-label="Homepage"><span class="brand-mark">&lt;/&gt;</span><span>{profile.name}<small>developer portfolio</small></span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Menu <span aria-hidden="true">☰</span></button>
      <nav id="main-navigation" aria-label="Main navigation">
        <a href={`${base}#projects`} data-section="projects" aria-current={isProject ? 'location' : undefined}>Projects</a>
        <a href={`${base}#background`} data-section="background">Experience</a>
        <a href={`${base}#skills`} data-section="skills">Skills</a>
        <a class="nav-contact" href={`${base}#contact`} data-section="contact">Contact <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    </div>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="shell footer"><span>© {new Date().getFullYear()} {profile.name}</span><a href={`${base}resume/`}>CV</a><a href="#main">Back to top ↑</a></footer>
  </body>
</html>
<script>
  const bar = document.querySelector<HTMLElement>('.navigation-bar');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav [data-section]')];
  const sections = links.map(link => document.getElementById(link.dataset.section!)).filter((section): section is HTMLElement => Boolean(section));
  function updateNavigation() {
    if (!bar || !sections.length) return;
    const threshold = bar.getBoundingClientRect().height + 90;
    let current: HTMLElement | undefined;
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= threshold) current = section;
    }
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 5) current = sections[sections.length - 1];
    links.forEach(link => {
      if (link.dataset.section === current?.id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  if (bar) {
    bar.dataset.enhanced = 'true';
    function closeMenu() {
      bar!.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.setProperty('--nav-height', `${bar!.getBoundingClientRect().height}px`);
    }
    toggle?.addEventListener('click', () => {
      const open = bar.classList.toggle('menu-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    links.forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && bar.classList.contains('menu-open')) {
        closeMenu();
        toggle?.focus();
      }
    });
    window.matchMedia('(min-width: 761px)').addEventListener('change', closeMenu);
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--nav-height', `${bar.getBoundingClientRect().height}px`);
      updateNavigation();
    }).observe(bar);
  }
  let pending = false;
  window.addEventListener('scroll', () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => { updateNavigation(); pending = false; });
  }, { passive: true });
  updateNavigation();
</script>
