---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
---
<article class:list={['project-card', { featured: p.featured }]}>
  <ProjectVisual project={project} compact />
  <div class="project-copy">
    <div class="project-meta"><span>{p.featured ? 'FEATURED PROJECT' : 'PERSONAL PROJECT'}</span><span class="status">{p.status}</span></div>
    <h3>{p.title}</h3><p>{p.summary}</p>
    <ul class="tags" aria-label="Project technologies">{p.tags.map(tag => <li>{tag}</li>)}</ul>
    <div class="project-links">
      <a class="text-link" href={`${import.meta.env.BASE_URL}projects/${project.id}/`} aria-label={`${p.title} project details`}>Explore project <span aria-hidden="true">→</span></a>
      {p.website && <a class="text-link" href={p.website} aria-label={`${p.title} live website`}>Live website <span aria-hidden="true">↗</span></a>}
      {p.repository && <a class="text-link" href={p.repository} aria-label={`${p.title} source code on GitHub`}>Source code <span aria-hidden="true">↗</span></a>}
      {p.release && <a class="text-link" href={p.release} aria-label={`${p.title} releases`}>Release <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
